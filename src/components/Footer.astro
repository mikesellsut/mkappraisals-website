---
import { NAV, SITE } from '../site.js';
const year = new Date().getFullYear();
---
<footer class="mt-20 border-t border-rule bg-white/70">
  <div class="wrap grid gap-10 py-12 sm:grid-cols-3">
    <div>
      <p class="font-serif text-2xl font-semibold text-burgundy">MK Appraisals</p>
      <p class="mt-1 text-sm text-ink/80">{SITE.owner}, {SITE.credential}</p>
      <p class="mt-1 text-sm text-ink/80">Sanpete, Millard, Juab &amp; Sevier counties, Utah</p>
    </div>
    <div class="text-sm">
      <p class="eyebrow mb-3">Contact</p>
      <p><a href={SITE.phoneHref}>{SITE.phone}</a></p>
      <p><a href={`mailto:${SITE.email}`}>{SITE.email}</a></p>
    </div>
    <nav class="text-sm" aria-label="Footer">
      <p class="eyebrow mb-3">Pages</p>
      <ul class="space-y-1">
        {NAV.map((n) => <li><a href={n.href} class="text-ink/85">{n.label}</a></li>)}
      </ul>
    </nav>
  </div>
  <div class="border-t border-rule">
    <div class="wrap flex flex-col gap-1 py-5 text-xs text-ink/65 sm:flex-row sm:justify-between">
      <p>&copy; {year} MK Appraisals. {SITE.owner}, {SITE.credential}.</p>
      <p>MK Appraisals is an independent appraisal company and is not affiliated with any lender.</p>
    </div>
  </div>
</footer>
