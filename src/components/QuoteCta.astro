---
import { SITE } from '../site.js';
const { heading = 'Need an appraisal?' } = Astro.props;
---
<section class="wrap mt-20">
  <div class="border-y border-rule py-12 text-center">
    <h2>{heading}</h2>
    <p class="mx-auto mt-3 max-w-xl text-ink/85">Tell me about the property and what the appraisal is for. I'll get back to you with a quote and a timeline.</p>
    <div class="mt-7 flex flex-col items-center justify-center gap-3 sm:flex-row">
      <a href="/contact/" class="btn">Request a Quote</a>
      <a href={SITE.phoneHref} class="btn-outline">Call {SITE.phone}</a>
    </div>
  </div>
</section>
