---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import { SITE } from '../site.js';
---
<Base
  title="Client Resources | MK Appraisals"
  description="Resources for homeowners and clients preparing for an appraisal with MK Appraisals in Central Utah."
>
  <PageHead
    eyebrow="Client Resources"
    title="Client resources"
    intro="Helpful information for homeowners and clients before the appraisal inspection."
  />

  <section class="wrap mt-12">
    <!--
      ==================================================================
      PLACEHOLDER: PROPERTY INFORMATION
      Owen (order desk) is providing the Property Information content.
      Mike sends it to borrowers and clients to fill out before the
      inspection. Do not add fields or content here until it arrives.
      ==================================================================
    -->
    <div id="property-information" class="scroll-mt-8 border border-dashed border-burgundy/50 bg-white/70 p-8" data-placeholder="property-information">
      <p class="eyebrow">Coming soon</p>
      <h2 class="mt-2">Property Information</h2>
      <p class="mt-3 max-w-prose text-ink/85">Before the inspection, I'll send you a short form about the property. You know the home better than anyone, and it helps me get the details right.</p>
      <p class="mt-3 max-w-prose text-sm text-ink/70">Questions in the meantime? Email <a href={`mailto:${SITE.email}`}>{SITE.email}</a> or call <a href={SITE.phoneHref}>{SITE.phone}</a>.</p>
    </div>
  </section>
</Base>
